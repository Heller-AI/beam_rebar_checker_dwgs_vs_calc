# Copy this file to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
ZHIPU_API_KEY=your-key-here
ZHIPU_MODEL=glm-5.3-flash
ACTIVE_PROVIDER=anthropic

# Access code for colleagues. Empty = anyone opening the app on your PC/network uses your keys.
APP_PASSWORD=

# Limits for people using your keys via the access code (optional, defaults shown)
MAX_AI_CALLS_PER_SESSION=30
MAX_AI_CALLS_PER_DAY=300
MAX_OUTPUT_TOKENS=4000

# Drawing mode (optional, defaults shown)
MAX_DRAWING_PAGES=10
MAX_DRAWING_CALLS_PER_SESSION=40
DRAWING_MAX_OUTPUT_TOKENS=32000
# Private reading rules added to the extraction instructions (optional, never shown in the app)
EXTRA_READING_RULES=
