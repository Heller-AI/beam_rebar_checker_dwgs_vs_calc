# For Streamlit Cloud: paste these lines into App settings -> Secrets (never commit a real secrets.toml).
# Shared keys are ONLY used by people who type the APP_PASSWORD access code.
# Everyone else must enter their own API key. Without APP_PASSWORD the keys are not shared at all.
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-opus-5-5"
ZHIPU_API_KEY = "..."
ZHIPU_MODEL = "glm-5.3-flash"
ACTIVE_PROVIDER = "anthropic"
APP_PASSWORD = "choose-a-long-code"
