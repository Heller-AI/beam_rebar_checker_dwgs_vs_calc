# For Streamlit Cloud: paste these lines into App settings -> Secrets with your real values.
# Never commit a real .streamlit/secrets.toml (it is git-ignored).
#
# Shared keys are ONLY used by people who type the APP_PASSWORD access code.
# Without APP_PASSWORD the keys are not shared at all; users must enter their own.
ANTHROPIC_API_KEY = "sk-ant-your-key-here"
ANTHROPIC_MODEL = "claude-opus-5-5"
ZHIPU_API_KEY = "your-key-here"
ZHIPU_MODEL = "glm-5.3-flash"
ACTIVE_PROVIDER = "anthropic"
APP_PASSWORD = "choose-a-long-random-code"

# Cost limits for the shared keys (optional, defaults shown).
# The daily cap is kept in memory and resets when the app restarts.
MAX_AI_CALLS_PER_SESSION = 30
MAX_AI_CALLS_PER_DAY = 300
MAX_OUTPUT_TOKENS = 4000
